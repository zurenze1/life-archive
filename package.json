{
  "name": "life-archive-desktop",
  "productName": "人生档案",
  "version": "1.0.0",
  "description": "在自己的电脑上自动整理可授权读取的生活线索",
  "main": "main.cjs",
  "author": "Life Archive",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "package": "electron-builder --mac dmg zip --arm64",
    "diagnose": "node scripts/diagnose.cjs"
  },
  "dependencies": {
    "koffi": "^2.15.1",
    "fflate": "^0.8.2",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.lifearchive.desktop",
    "productName": "人生档案",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "core/**",
      "ui/**",
      "package.json",
      "README.md"
    ],
    "asarUnpack": [
      "node_modules/koffi/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "icon": "build/icon.icns",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "点击录音按钮时，人生档案使用麦克风保存你自己的录音。"
      }
    },
    "dmg": {
      "title": "人生档案 1.0",
      "contents": [
        {
          "x": 130,
          "y": 160,
          "type": "file"
        },
        {
          "x": 410,
          "y": 160,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "artifactName": "LifeArchive-${version}-${arch}.${ext}"
  },
  "homepage": "https://github.com/zurenze1/life-archive",
  "repository": {
    "type": "git",
    "url": "https://github.com/zurenze1/life-archive.git"
  },
  "bugs": {
    "url": "https://github.com/zurenze1/life-archive/issues"
  },
  "engines": {
    "node": ">=24"
  }
}
